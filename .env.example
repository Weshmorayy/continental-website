# ── Supabase ──────────────────────────────────────────────────────────────
# Tableau de bord → Project Settings → API
# Les deux clés ci-dessous sont PUBLIQUES par nature : elles finissent dans le
# navigateur. La sécurité ne repose pas dessus, mais sur les politiques RLS
# de 002_rls.sql. Ne jamais mettre ici la clé `service_role` : elle contourne
# RLS et viderait le site de toute protection.
NEXT_PUBLIC_SUPABASE_URL=https://tbaizfoircknsznmpcvb.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...

# Bucket de stockage des images (défini dans 003_storage.sql)
NEXT_PUBLIC_SUPABASE_BUCKET=continental

# ── Déploiement (facultatif) ──────────────────────────────────────────────
# URL publique du site, utilisée par sitemap.ts et les balises og:url.
NEXT_PUBLIC_SITE_URL=https://continental-dakar.com
